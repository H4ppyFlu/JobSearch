#!/bin/sh
# Refuses a commit message that contains personal values. See pre-commit.
root=$(git rev-parse --show-toplevel)
py="$root/.venv/Scripts/python.exe"
[ -x "$py" ] || py="$root/.venv/bin/python"
if [ ! -x "$py" ]; then
    echo "Commit abgelehnt: kein Python in .venv, die Prüfung auf persönliche Daten kann nicht laufen." >&2
    exit 1
fi
exec "$py" -m jobsearch.guard message "$1"
